// Configurazione Cloudflare Workers: l'app è un sito statico (index.html, icone, media), senza codice lato server.
// Serve anche alle anteprime dei rami (`wrangler versions upload`), che non riconoscono da sole i file statici.
{
  "name": "osteo-help",
  "compatibility_date": "2026-10-20",
  "assets": {
    "directory": "./"
  }
}
